<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width">
<title>MLB Scores</title>
</head>
<body>
<h2>MLB SCORES</h2>
<p id="date"></p>
<p>
<a id="prev" href="#">Previous</a> |
<a id="today" href="index.html">Today</a> |
<a id="next" href="#">Next</a>
</p>
<p><a href="" onclick="location.reload();return false;">Refresh scores</a></p>
<div id="scores">Loading scores...</div>

<script>
var params = new URLSearchParams(location.search);
var date = params.get("date") || new Date().toISOString().slice(0,10);

function shiftDate(n) {
  var d = new Date(date + "T12:00:00Z");
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().slice(0,10);
}

document.getElementById("date").innerHTML = date;
document.getElementById("prev").href = "?date=" + shiftDate(-1);
document.getElementById("today").href = "index.html";
document.getElementById("next").href = "?date=" + shiftDate(1);

fetch("https://statsapi.mlb.com/api/v1/schedule?sportId=1&date=" + date + "&hydrate=team,linescore")
.then(function(r) { return r.json(); })
.then(function(data) {
  var games = data.dates && data.dates[0] ? data.dates[0].games : [];
  var out = "";
  games.forEach(function(g) {
    var a = g.teams.away;
    var h = g.teams.home;
    out += "<hr><b>" + a.team.name + "</b> " + (a.score == null ? "-" : a.score);
    out += "<br><b>" + h.team.name + "</b> " + (h.score == null ? "-" : h.score);
    out += "<br>" + g.status.detailedState + "<br>";
    if (g.linescore && g.status.abstractGameState === "Live") {
      out += "Inning: " + g.linescore.currentInning + "<br>";
    }
  });
  document.getElementById("scores").innerHTML =
    out || "No games listed for this date.";
})
.catch(function() {
  document.getElementById("scores").innerHTML =
    "Could not load scores. Try refreshing.";
});
</script>
</body>
</html>
